+static void max77849_cable_work(struct work_struct *work)
+{
+	struct max77693_charger *chg = container_of(work, struct max77693_charger,
+						    cable_work);
+	struct regmap *regmap = chg->max77693->regmap;
+	u32 ilim, cc;
+
+	if (extcon_get_state(chg->edev, EXTCON_CHG_USB_DCP) > 0 ||
+	    extcon_get_state(chg->edev, EXTCON_CHG_USB_CDP) > 0 ||
+	    extcon_get_state(chg->edev, EXTCON_CHG_USB_FAST) > 0) {
+		ilim = chg->dcp_input_current;
+		cc = chg->dcp_charge_current;
+	} else if (extcon_get_state(chg->edev, EXTCON_CHG_USB_SDP) > 0 ||
+		   extcon_get_state(chg->edev, EXTCON_CHG_USB_SLOW) > 0) {
+		ilim = chg->usb_input_current;
+		cc = chg->usb_charge_current;
+	} else {
+		/* No cable (or unknown type): leave the current settings */
+		power_supply_changed(chg->charger);
+		return;
+	}
+
+	max77849_set_current(regmap, MAX77693_CHG_REG_CHG_CNFG_09,
+			     CHG_CNFG_09_CHGIN_ILIM_MASK, MAX77849_CHGIN_ILIM_STEP, ilim);
+	max77849_set_current(regmap, MAX77693_CHG_REG_CHG_CNFG_02,
+			     CHG_CNFG_02_CC_MASK, MAX77849_CHG_CC_STEP, cc);
+	dev_info(chg->dev, "cable: input limit %u mA, charge current %u mA\n",
+		 ilim / 1000, cc / 1000);
+
+	power_supply_changed(chg->charger);
+}
+
+static int max77849_cable_notifier(struct notifier_block *nb,
+				   unsigned long event, void *ptr)
+{
+	struct max77693_charger *chg = container_of(nb, struct max77693_charger,
+						    cable_nb);
+
+	schedule_work(&chg->cable_work);
+
+	return NOTIFY_OK;
+}
