+static int max77849_get_current(struct regmap *regmap, unsigned int reg,
+				unsigned int mask, unsigned int step, int *val)
+{
+	unsigned int data;
+	int ret;
+
+	ret = regmap_read(regmap, reg, &data);
+	if (ret < 0)
+		return ret;
+
+	*val = (data & mask) * step;
+
+	return 0;
+}
+
+static int max77849_set_current(struct regmap *regmap, unsigned int reg,
+				unsigned int mask, unsigned int step, u32 uA)
+{
+	return regmap_update_bits(regmap, reg, mask, min(uA / step, mask));
+}
