From: gt510 <gt510@localhost>
Subject: media: venus: venc: do not offer VIDIOC_CREATE_BUFS on HFI 1.x

The HFI 1.x firmware (msm8916) is told the buffer count once at stream
start and aborts the session when an unknown buffer is queued. GStreamer
grows its buffer pools with VIDIOC_CREATE_BUFS during streaming whenever the
ioctl probes as supported (a 6th input and a 5th capture buffer here), which
killed every encode; v4l2-ctl, which never grows its pools, worked. Return
-ENOTTY on 1.x so clients stay with the REQBUFS count.
---
--- a/drivers/media/platform/qcom/venus/venc.c
+++ b/drivers/media/platform/qcom/venus/venc.c
@@ -569,6 +569,23 @@
 	return ret;
 }
 
+static int venc_create_bufs(struct file *file, void *fh,
+			    struct v4l2_create_buffers *create)
+{
+	struct venus_inst *inst = to_inst(file);
+
+	/*
+	 * The HFI 1.x firmware learns the buffer count once, at stream start
+	 * (BUFFER_COUNT_ACTUAL), and aborts the session as soon as a buffer it
+	 * does not know about is queued. GStreamer grows its pools with
+	 * CREATE_BUFS whenever the ioctl probes as available, so hide it.
+	 */
+	if (IS_V1(inst->core))
+		return -ENOTTY;
+
+	return v4l2_m2m_ioctl_create_bufs(file, fh, create);
+}
+
 static const struct v4l2_ioctl_ops venc_ioctl_ops = {
 	.vidioc_querycap = venc_querycap,
 	.vidioc_enum_fmt_vid_cap = venc_enum_fmt,
@@ -583,7 +600,7 @@
 	.vidioc_s_selection = venc_s_selection,
 	.vidioc_reqbufs = v4l2_m2m_ioctl_reqbufs,
 	.vidioc_querybuf = v4l2_m2m_ioctl_querybuf,
-	.vidioc_create_bufs = v4l2_m2m_ioctl_create_bufs,
+	.vidioc_create_bufs = venc_create_bufs,
 	.vidioc_prepare_buf = v4l2_m2m_ioctl_prepare_buf,
 	.vidioc_qbuf = v4l2_m2m_ioctl_qbuf,
 	.vidioc_expbuf = v4l2_m2m_ioctl_expbuf,
