+static u8 *qcom_cpufreq_read_named_cell(struct device_node *np, const char *id)
+{
+	struct nvmem_cell *cell;
+	u8 *val;
+
+	cell = of_nvmem_cell_get(np, id);
+	if (IS_ERR(cell))
+		return ERR_CAST(cell);
+
+	val = nvmem_cell_read(cell, NULL);
+	nvmem_cell_put(cell);
+	return val;
+}
+
+/*
+ * MSM8916/APQ8016: the speed bin sits in one of two fuse fields, selected by
+ * the PVS fuse ("bin2" when set, "bin1" otherwise). The generic speedbin cell
+ * passed in is unused; the named cells come from the CPU OPP table node.
+ */
+static int qcom_cpufreq_msm8916_get_version(struct device *cpu_dev,
+					    struct nvmem_cell *speedbin_nvmem,
+					    char **pvs_name,
+					    struct qcom_cpufreq_drv *drv)
+{
+	struct device_node *np __free(device_node) =
+		dev_pm_opp_of_get_opp_desc_node(cpu_dev);
+	u8 *pvs, *speedbin;
+
+	*pvs_name = NULL;
+	if (!np)
+		return -ENOENT;
+
+	pvs = qcom_cpufreq_read_named_cell(np, "pvs");
+	if (IS_ERR(pvs))
+		return PTR_ERR(pvs);
+
+	speedbin = qcom_cpufreq_read_named_cell(np, *pvs ? "bin2" : "bin1");
+	if (IS_ERR(speedbin)) {
+		kfree(pvs);
+		return PTR_ERR(speedbin);
+	}
+
+	dev_dbg(cpu_dev, "speedbin: %d (pvs: %d)\n", *speedbin, *pvs);
+	drv->versions = 1 << *speedbin;
+	kfree(speedbin);
+	kfree(pvs);
+	return 0;
+}
