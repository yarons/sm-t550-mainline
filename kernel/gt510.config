# gt510 additions on top of the pmOS msm8916 config
CONFIG_MFD_MAX77693=m
CONFIG_CHARGER_MAX77693=m
CONFIG_EXTCON_MAX77693=m
CONFIG_VIDEO_SR200PC20=m
CONFIG_VIDEO_SR544=m
CONFIG_VIDEO_DW9807_VCM=m

# System suspend (s2idle): the pmOS msm8916 config leaves it off; GNOME suspends after 15 min idle on battery.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
