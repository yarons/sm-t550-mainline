From: gt510 <gt510@localhost>
Subject: clapper-gtk: video through gtk4paintablesink and GtkGraphicsOffload

ClapperGtkVideo always plays into glsinkbin + clappersink on GStreamer
1.24+. On SM-T550 (Adreno 306, Venus H.264 decoder, phoc) that sink does
not work at all ("Configured videosink glsinkbin0 is not working", no
picture), and where it works it turns every frame into a GL texture that
GTK has to draw itself.

gtk4paintablesink (gst-plugins-rs) accepts DMA_DRM buffers and hands them
to GTK as GdkDmabufTextures, and ClapperGtkVideo already wraps a sink's
"paintable" in a GtkPicture. Use it when it is installed
(CLAPPER_GTK4PAINTABLESINK=0 restores the old path), and put the picture
in a GtkGraphicsOffload with a black background, as GNOME Showtime does:
only then does GTK offload the frames to the compositor. A YouTube 1080p
H.264 stream (clapper-enhancers yt-dlp) then shows at ~25 fps instead of
10 fps with GTK drawing each frame.
---
--- a/src/lib/clapper-gtk/clapper-gtk-video.c
+++ b/src/lib/clapper-gtk/clapper-gtk-video.c
@@ -789,8 +789,17 @@
 
     if (G_LIKELY (paintable != NULL)) {
       if (GDK_IS_PAINTABLE (paintable)) {
-        widget = g_object_ref_sink (gtk_picture_new ());
-        gtk_picture_set_paintable (GTK_PICTURE (widget), GDK_PAINTABLE (paintable));
+        GtkWidget *picture = gtk_picture_new ();
+
+        gtk_picture_set_paintable (GTK_PICTURE (picture), GDK_PAINTABLE (paintable));
+#if GTK_CHECK_VERSION(4,16,0)
+        /* GTK hands dmabuf frames to the compositor (a subsurface) only
+         * inside a GtkGraphicsOffload; a bare GtkPicture is drawn by GTK */
+        widget = g_object_ref_sink (gtk_graphics_offload_new (picture));
+        gtk_graphics_offload_set_black_background (GTK_GRAPHICS_OFFLOAD (widget), TRUE);
+#else
+        widget = g_object_ref_sink (picture);
+#endif
       }
       g_object_unref (paintable);
     }
@@ -1197,6 +1206,7 @@
   GstElement *vsink;
   ClapperPlayer *player;
   ClapperQueue *queue;
+  gboolean paintable_sink = FALSE;
 
   G_OBJECT_CLASS (parent_class)->constructed (object);
 
@@ -1208,11 +1218,27 @@
   g_signal_connect (player, "notify::video-sink",
       G_CALLBACK (_video_sink_changed_cb), self);
 
-  vsink = gst_element_factory_make ("clappersink", NULL);
+  /* gtk4paintablesink (gst-plugins-rs) takes DMA_DRM buffers and hands them
+   * to GTK as GdkDmabufTextures, which GTK can offload to the compositor;
+   * glsinkbin + clappersink below makes GL textures that GTK always has to
+   * draw itself (on an Adreno 306: 1080p at ~10 fps instead of 25-30).
+   * _video_sink_changed_cb() wraps its "paintable" in a GtkPicture.
+   * CLAPPER_GTK4PAINTABLESINK=0 restores the clappersink path. */
+  vsink = NULL;
+  if (g_strcmp0 (g_getenv ("CLAPPER_GTK4PAINTABLESINK"), "0") != 0)
+    vsink = gst_element_factory_make ("gtk4paintablesink", NULL);
 
+  if (vsink) {
+    GST_INFO_OBJECT (self, "Using gtk4paintablesink");
+    clapper_player_set_video_sink (player, vsink);
+    paintable_sink = TRUE;
+  } else {
+    vsink = gst_element_factory_make ("clappersink", NULL);
+  }
+
   /* FIXME: This is a temporary workaround for lack
    * of DMA_DRM negotiation support in sink itself */
-  if (G_LIKELY (vsink != NULL)) {
+  if (G_LIKELY (vsink != NULL) && !paintable_sink) {
     guint major = 0, minor = 0, micro = 0, nano = 0;
 
     gst_version (&major, &minor, &micro, &nano);
