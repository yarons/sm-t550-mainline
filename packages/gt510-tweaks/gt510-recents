#!/bin/sh
# SM-T550 "Recents" touch key (KEY_APPSELECT) -> Phosh overview. Phosh cannot bind the
# XF86AppSelect keysym, so hkdm catches the key below the compositor and we send Super+A
# (toggle-application-view) through the virtual keyboard of the running Phosh session.
pid=$(pgrep -x phosh | head -1)
[ -n "$pid" ] || exit 0
user=$(stat -c %U "/proc/$pid")
uid=$(id -u "$user")
exec su -s /bin/sh "$user" -c "XDG_RUNTIME_DIR=/run/user/$uid WAYLAND_DISPLAY=wayland-0 wtype -M logo a -m logo"
