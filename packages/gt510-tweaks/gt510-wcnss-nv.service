[Unit]
Description=Copy this tablet's Wi-Fi/Bluetooth NV file from the stock system partition (once)
DefaultDependencies=no
After=systemd-remount-fs.service
Before=systemd-udev-trigger.service sysinit.target shutdown.target
Conflicts=shutdown.target
ConditionPathExists=!/lib/firmware/updates/wlan/prima/WCNSS_qcom_wlan_nv.bin

[Service]
Type=oneshot
ExecStart=/usr/libexec/gt510-wcnss-nv

[Install]
WantedBy=sysinit.target
