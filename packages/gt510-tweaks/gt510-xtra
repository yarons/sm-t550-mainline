#!/bin/sh
# gt510-tweaks (ISSUES 29): GNSS assistance for the modem engine, as stock Android does via izat/gps.conf. Downloads
# Qualcomm XTRA predicted orbits from the servers the modem names (QMI LOC predicted-orbits source), caches them, and
# injects UTC time (only when the clock is NTP-synced) plus the XTRA data. Without it a cold start took ~12 min.
CACHE=/var/cache/gt510-xtra
FILE=$CACHE/xtra.bin
QMI="qmicli -d qrtr://0"
FALLBACK="http://xtrapath1.izatcloud.net/xtra3grc.bin http://xtrapath2.izatcloud.net/xtra3grc.bin http://xtrapath3.izatcloud.net/xtra3grc.bin"
mkdir -p $CACHE

# The modem's LOC service appears some seconds after boot (rmtfs, remoteproc).
for i in $(seq 30); do $QMI --loc-noop >/dev/null 2>&1 && break; sleep 2; done

# Refresh when the cache is older than 20 h (servers publish several times a day; data is valid for 7 days).
if [ -z "$(find $FILE -mmin -1200 2>/dev/null)" ]; then
	urls=$($QMI --loc-get-predicted-orbits-data-source 2>/dev/null | sed -n "s/.*Server [0-9]*: '\(.*\)'/\1/p")
	for url in ${urls:-$FALLBACK}; do
		if wget -q -T 20 -O $FILE.new "$url" && [ -s $FILE.new ]; then
			mv $FILE.new $FILE && echo "gt510-xtra: downloaded $url ($(wc -c < $FILE) bytes)"
			break
		fi
	done
	rm -f $FILE.new
fi

[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = yes ] &&
	$QMI --loc-inject-time >/dev/null 2>&1 && echo "gt510-xtra: injected UTC time"

# Older XTRA data is past its 7-day validity.
if [ -z "$(find $FILE -mmin -10080 2>/dev/null)" ]; then
	echo "gt510-xtra: no XTRA data younger than 7 days (offline?)"
	exit 1
fi
/usr/libexec/gt510-xtra-inject $FILE || exit 1
$QMI --loc-get-predicted-orbits-data-validity 2>/dev/null | sed -n 's/^Successfully retrieved validity info: /gt510-xtra: modem XTRA /p'
