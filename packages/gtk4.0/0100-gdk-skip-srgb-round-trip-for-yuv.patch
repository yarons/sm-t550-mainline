From: gt510 <gt510@localhost>
Subject: gdk: skip sRGB round trip when converting sRGB-primaries YUV to sRGB

---
--- a/gdk/gdkcolorstate.c	2026-09-25 15:29:13
+++ b/gdk/gdkcolorstate.c	2026-09-25 15:29:13
@@ -761,6 +761,13 @@
                      float            (*values)[4],
                      gsize              n_values)
 {
+  /* sRGB primaries and transfer on both sides: the linearize, primaries
+   * matrix and re-encode steps cancel out, so only the YUV->RGB matrix
+   * matters. Skipping them avoids 6 powf() per pixel, which makes software
+   * rendering of camera frames unusably slow on small ARM cores. */
+  gboolean srgb_passthrough = self->eotf == srgb_eotf && oetf == srgb_oetf &&
+                              self->cicp.color_primaries == 1;
+
   for (gsize i = 0; i < n_values; i++)
     {
       if (self->cicp.range == GDK_CICP_RANGE_NARROW)
@@ -781,6 +788,8 @@
           values[i][1] = res[1];
           values[i][2] = res[2];
         }
+      if (srgb_passthrough)
+        continue;
       if (self->eotf != NONE)
         self->eotf (values[i]);
       if (matrix != IDENTITY)
