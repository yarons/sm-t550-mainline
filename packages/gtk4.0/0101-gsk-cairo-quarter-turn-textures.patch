From: gt510 <gt510@localhost>
Subject: gsk: cairo: rotate quarter-turn textures before scaling

---
--- a/gsk/gsktexturenode.c	2026-09-25 17:15:36
+++ b/gsk/gsktexturenode.c	2026-09-25 17:35:06
@@ -131,6 +131,94 @@
   cairo_paint (cr);
 }
 
+/* Rotating and scaling in one step sends pixman down its generic affine
+ * paths, which cost ~50 ms per camera frame on a Cortex-A53. For
+ * quarter-turn transforms (optionally mirrored, as for front cameras),
+ * rotate 1:1 first (nearest filter, pixman's rotate blit, exact) and then
+ * scale axis-aligned, doing any mirroring as a vertical flip (NEON bilinear
+ * scanlines only need a positive x scale). */
+static gboolean
+gsk_texture_node_draw_quarter_turn (cairo_t               *cr,
+                                    cairo_surface_t       *surface,
+                                    int                    width,
+                                    int                    height,
+                                    const graphene_rect_t *bounds)
+{
+  cairo_matrix_t ctm, rot, m;
+  cairo_surface_t *rotated;
+  cairo_pattern_t *pattern;
+  cairo_t *rc;
+  double x[4], y[4], x0, y0, x1, y1, sx, sy;
+  int sxy, syx, i;
+  gboolean flip;
+
+  cairo_get_matrix (cr, &ctm);
+  if (ABS (ctm.xx) > 1e-6 || ABS (ctm.yy) > 1e-6 ||
+      ABS (ctm.xy) < 1e-6 || ABS (ctm.yx) < 1e-6 ||
+      width * height < 256 * 256)
+    return FALSE;
+
+  /* Device-space rectangle covered by the node */
+  x[0] = bounds->origin.x;                      y[0] = bounds->origin.y;
+  x[1] = bounds->origin.x + bounds->size.width; y[1] = bounds->origin.y;
+  x[2] = bounds->origin.x;                      y[2] = bounds->origin.y + bounds->size.height;
+  x[3] = x[1];                                  y[3] = y[2];
+  for (i = 0; i < 4; i++)
+    cairo_user_to_device (cr, &x[i], &y[i]);
+  x0 = MIN (MIN (x[0], x[1]), MIN (x[2], x[3]));
+  x1 = MAX (MAX (x[0], x[1]), MAX (x[2], x[3]));
+  y0 = MIN (MIN (y[0], y[1]), MIN (y[2], y[3]));
+  y1 = MAX (MAX (y[0], y[1]), MAX (y[2], y[3]));
+  if (x1 - x0 < 1 || y1 - y0 < 1)
+    return FALSE;
+
+  /* Device x follows texture y (sign sxy), device y follows texture x (syx).
+   * Always use a pure rotation (rx = sxy * ty, ry = -sxy * tx); if that gets
+   * device y backwards, the transform was mirrored: flip rows when scaling. */
+  sxy = ctm.xy > 0 ? 1 : -1;
+  syx = ctm.yx > 0 ? 1 : -1;
+  flip = syx == sxy;
+
+  rotated = cairo_surface_create_similar_image (surface,
+                                                cairo_image_surface_get_format (surface),
+                                                height, width);
+  if (cairo_surface_status (rotated) != CAIRO_STATUS_SUCCESS)
+    {
+      cairo_surface_destroy (rotated);
+      return FALSE;
+    }
+  cairo_matrix_init (&rot, 0, -sxy, sxy, 0,
+                     sxy > 0 ? 0 : height, sxy > 0 ? width : 0);
+  rc = cairo_create (rotated);
+  cairo_set_operator (rc, CAIRO_OPERATOR_SOURCE);
+  cairo_set_matrix (rc, &rot);
+  cairo_set_source_surface (rc, surface, 0, 0);
+  cairo_pattern_set_filter (cairo_get_source (rc), CAIRO_FILTER_NEAREST);
+  cairo_paint (rc);
+  cairo_destroy (rc);
+
+  cairo_save (cr);
+  cairo_identity_matrix (cr);
+  pattern = cairo_pattern_create_for_surface (rotated);
+  cairo_pattern_set_extend (pattern, CAIRO_EXTEND_PAD);
+  cairo_pattern_set_filter (pattern, CAIRO_FILTER_BILINEAR);
+  sx = height / (x1 - x0);
+  sy = width / (y1 - y0);
+  if (flip)
+    cairo_matrix_init (&m, sx, 0, 0, -sy, -x0 * sx, width + y0 * sy);
+  else
+    cairo_matrix_init (&m, sx, 0, 0, sy, -x0 * sx, -y0 * sy);
+  cairo_pattern_set_matrix (pattern, &m);
+  cairo_set_source (cr, pattern);
+  cairo_pattern_destroy (pattern);
+  cairo_surface_destroy (rotated);
+  cairo_rectangle (cr, x0, y0, x1 - x0, y1 - y0);
+  cairo_fill (cr);
+  cairo_restore (cr);
+
+  return TRUE;
+}
+
 static void
 gsk_texture_node_draw (GskRenderNode *node,
                        cairo_t       *cr,
@@ -155,6 +243,11 @@
     return;
 
   surface = gdk_texture_download_surface (self->texture, data->ccs);
+  if (gsk_texture_node_draw_quarter_turn (cr, surface, width, height, &bounds))
+    {
+      cairo_surface_destroy (surface);
+      return;
+    }
   pattern = cairo_pattern_create_for_surface (surface);
   cairo_pattern_set_extend (pattern, CAIRO_EXTEND_PAD);
 
