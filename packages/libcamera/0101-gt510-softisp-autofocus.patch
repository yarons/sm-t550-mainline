+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-detection autofocus for the software ISP
+ */
+
+#pragma once
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class State {
+		Coarse,
+		Fine,
+		Locked,
+	};
+
+	void startScan(IPAContext &context);
+	void moveTo(IPAContext &context, int32_t position);
+
+	/* Tuning */
+	int32_t min_ = 0;
+	int32_t max_ = 1023;
+	int32_t coarseStep_ = 93;
+	int32_t fineStep_ = 24;
+	unsigned int settle_ = 1;
+	double dropRatio_ = 0.6;
+
+	State state_ = State::Coarse;
+	int32_t position_ = 0;
+	int32_t fineEnd_ = 0;
+	int32_t best_ = 0;
+	double bestSharpness_ = -1.0;
+	unsigned int wait_ = 0;
+	bool lockedMeasured_ = false;
+	double lockedSharpness_ = 0.0;
+	double lockedBrightness_ = 0.0;
+	unsigned int changeCount_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
