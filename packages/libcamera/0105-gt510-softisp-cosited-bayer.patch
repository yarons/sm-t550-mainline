 			<< "Unsupported number of output streams: "
@@ -532,12 +544,70 @@ void DebayerEGL::setShaderVariableValues(eGLImage &eglImageIn, const DebayerPara
 	return;
 }
 
+/*
+ * Pack every 2x2 cell of a RAW10 CSI-2 frame (8 MSBs) into one RGBA texel
+ * (R, G, B, G). The sensor took the four samples at one spot, so a bilinear
+ * lookup of this texture is the demosaic.
+ */
+void DebayerEGL::unpackCosited(const uint8_t *src)
+{
+	const unsigned int rx = firstRed_x_ != 0.0f, ry = firstRed_y_ != 0.0f;
+	const unsigned int stride = inputConfig_.stride;
+	uint8_t *out = cositedCells_.data();
+
+	for (unsigned int y = 0; y < height_; y += 2) {
+		const uint8_t *row[2] = { src + y * stride, src + (y + 1) * stride };
+		const uint8_t *r = row[ry], *b = row[ry ^ 1];
+
+		/* 5 bytes per 4 pixels: two cells, MSBs in bytes 0..3 */
+		for (unsigned int g = 0; g < width_ / 4; g++, r += 5, b += 5) {
+			out[0] = r[rx];
+			out[1] = r[rx ^ 1];
+			out[2] = b[rx ^ 1];
+			out[3] = b[rx];
+			out[4] = r[2 + rx];
+			out[5] = r[2 + (rx ^ 1)];
+			out[6] = b[2 + (rx ^ 1)];
+			out[7] = b[2 + rx];
+			out += 8;
+		}
+	}
+}
+
 eGLImage *DebayerEGL::getCachedInputFrameBuffer(FrameBuffer *input, std::optional<MappedFrameBuffer> *inMapped, std::optional<DmaSyncer> *inDmaSyncer)
 {
 	const SharedFD &fd = input->planes()[0].fd;
 	bool cache_miss = true;
 	eGLImage *eglImageIn;
 
+	if (cosited_) {
+		if (!cositedImage_) {
+			cositedImage_ = std::make_unique<eGLImage>(GL_RGBA, width_ / 2, height_ / 2,
+								   width_ * 2, GL_TEXTURE0, 0);
+			cositedCells_.resize(width_ / 2 * height_ / 2 * 4);
+			cositedTextureCreated_ = false;
+		}
+
+		inDmaSyncer->emplace(input->planes()[0].fd, DmaSyncer::SyncType::Read);
+		inMapped->emplace(input, MappedFrameBuffer::MapFlag::Read);
+		if (!inMapped->value().isValid()) {
+			LOG(Debayer, Error) << "mmap-ing buffer(s) failed";
+			return nullptr;
+		}
+		unpackCosited(inMapped->value().planes()[0].data());
+
+		if (!cositedTextureCreated_) {
+			egl_.createTexture2D(*cositedImage_, cositedCells_.data());
+			/* The bilinear filter interpolates the co-sited cells */
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+			cositedTextureCreated_ = true;
+		} else {
+			egl_.updateTexture2D(*cositedImage_, cositedCells_.data());
+		}
+		return cositedImage_.get();
+	}
+
 	for (auto &[ifd, img] : eglImageInCache_) {
 		if (ifd == fd) {
 			eglImageIn = img.get();
@@ -725,6 +795,7 @@ void DebayerEGL::stop()
 {
 	eglImageOutCache_.clear();
 	eglImageInCache_.clear();
+	cositedImage_.reset();
 
 	if (programId_)
 		glDeleteProgram(programId_);
