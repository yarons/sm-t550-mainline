--- a/src/ipa/simple/algorithms/af.cpp
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -3,15 +3,19 @@
  * Contrast-detection autofocus for the software ISP
  *
  * The statistics provide a focus measure (sum of absolute differences of
- * neighbouring green samples). Normalised by the green sum it is roughly
- * independent of exposure. The lens is swept coarsely over its range, then
- * finely around the best position, and parked there. A lasting drop of the
- * focus measure or a large brightness change (scene change) restarts the scan.
+ * neighbouring green samples) for every frame. Normalised by the green sum it
+ * is roughly independent of exposure. The lens is swept coarsely from one end
+ * of its range until the measure has clearly fallen past a peak, the peak is
+ * refined by a parabola through the best coarse position and its neighbours
+ * and checked with three fine steps around it, and the lens is parked at the
+ * best position. A lasting drop of the focus measure or a large brightness
+ * change (scene change) restarts the scan.
  */
 
 #include "af.h"
 
 #include <algorithm>
+#include <cmath>
 #include <errno.h>
 #include <stdint.h>
 
@@ -30,7 +34,9 @@ int Af::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
 	coarseStep_ = tuningData["coarseStep"].get<int32_t>().value_or(coarseStep_);
 	fineStep_ = tuningData["fineStep"].get<int32_t>().value_or(fineStep_);
 	settle_ = tuningData["settle"].get<uint32_t>().value_or(settle_);
+	stopRatio_ = tuningData["stopRatio"].get<double>().value_or(stopRatio_);
 	dropRatio_ = tuningData["dropRatio"].get<double>().value_or(dropRatio_);
+	changeFrames_ = tuningData["changeFrames"].get<uint32_t>().value_or(changeFrames_);
 
 	if (max_ <= min_ || coarseStep_ <= 0 || fineStep_ <= 0) {
 		LOG(IPASoftAf, Error) << "Invalid autofocus tuning";
@@ -43,60 +49,96 @@ int Af::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
 int Af::configure(IPAContext &context,
 		  [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
-	startScan(context);
+	startScan(context, 0);
 	return 0;
 }
 
-void Af::moveTo(IPAContext &context, int32_t position)
+void Af::moveTo(IPAContext &context, uint32_t frame, int32_t position)
 {
 	position_ = std::clamp(position, min_, max_);
 	context.activeState.af.position = position_;
 	context.activeState.af.changed = true;
-	wait_ = settle_;
+	/*
+	 * The frames already being exposed when the lens moves are blurred
+	 * by the move: use the first one exposed after it has settled.
+	 */
+	measureFrame_ = frame + settle_ + 1;
 }
 
-void Af::startScan(IPAContext &context)
+void Af::startScan(IPAContext &context, uint32_t frame)
 {
 	state_ = State::Coarse;
+	coarse_.clear();
 	best_ = min_;
 	bestSharpness_ = -1.0;
+	fallCount_ = 0;
 	lockedMeasured_ = false;
 	changeCount_ = 0;
-	moveTo(context, min_);
+	moveTo(context, frame, min_);
 	/* Travel from anywhere to one end of the range takes longer */
-	wait_ = settle_ + 1;
+	measureFrame_++;
+}
+
+void Af::startFine(IPAContext &context, uint32_t frame)
+{
+	/* Coarse positions are min_ + k * coarseStep_, the last one clamped */
+	unsigned int i = 0;
+	while (i + 1 < coarse_.size() &&
+	       std::min(min_ + static_cast<int32_t>(i) * coarseStep_, max_) != best_)
+		i++;
+
+	double center = best_;
+	if (i > 0 && i + 1 < coarse_.size()) {
+		const double s0 = coarse_[i - 1], s1 = coarse_[i], s2 = coarse_[i + 1];
+		const double denom = s0 - 2.0 * s1 + s2;
+		if (denom < 0.0) {
+			double offset = 0.5 * (s0 - s2) / denom;
+			offset = std::clamp(offset, -0.5, 0.5);
+			center += offset * coarseStep_;
+		}
+	}
+
+	const int32_t c = static_cast<int32_t>(std::lround(center));
+	fine_.clear();
+	for (int32_t p : { c - fineStep_, c, c + fineStep_ }) {
+		p = std::clamp(p, min_, max_);
+		if (std::find(fine_.begin(), fine_.end(), p) == fine_.end())
+			fine_.push_back(p);
+	}
+
+	state_ = State::Fine;
+	fineIndex_ = 0;
+	moveTo(context, frame, fine_[0]);
 }
 
 void Af::process(IPAContext &context,
-		 [[maybe_unused]] const uint32_t frame,
+		 const uint32_t frame,
 		 [[maybe_unused]] IPAFrameContext &frameContext,
 		 const SwIspStats *stats,
 		 [[maybe_unused]] ControlList &metadata)
 {
-	if (!stats->valid)
-		return;
-
-	if (wait_) {
-		wait_--;
+	if (!stats->focusValid || frame < measureFrame_)
 		return;
-	}
 
 	const double green = static_cast<double>(std::max<uint64_t>(stats->sum_.g(), 1));
 	const double sharpness = static_cast<double>(stats->sharpness) / green;
 
 	switch (state_) {
 	case State::Coarse:
+		coarse_.push_back(sharpness);
 		if (sharpness > bestSharpness_) {
 			bestSharpness_ = sharpness;
 			best_ = position_;
+			fallCount_ = 0;
+		} else if (sharpness < bestSharpness_ * stopRatio_) {
+			fallCount_++;
 		}
-		if (position_ >= max_) {
-			state_ = State::Fine;
-			fineEnd_ = std::min(max_, best_ + coarseStep_);
-			moveTo(context, best_ - coarseStep_);
-		} else {
-			moveTo(context, position_ + coarseStep_);
-		}
+
+		/* Stop once clearly past a peak, or at the end of the range */
+		if (position_ >= max_ || fallCount_ >= 2)
+			startFine(context, frame);
+		else
+			moveTo(context, frame, position_ + coarseStep_);
 		break;
 
 	case State::Fine:
@@ -104,14 +146,16 @@ void Af::process(IPAContext &context,
 			bestSharpness_ = sharpness;
 			best_ = position_;
 		}
-		if (position_ >= fineEnd_) {
+
+		if (++fineIndex_ < fine_.size()) {
+			moveTo(context, frame, fine_[fineIndex_]);
+		} else {
 			state_ = State::Locked;
 			lockedMeasured_ = false;
-			moveTo(context, best_);
+			moveTo(context, frame, best_);
 			LOG(IPASoftAf, Debug) << "Focused at " << best_
-					      << " (sharpness " << bestSharpness_ << ")";
-		} else {
-			moveTo(context, position_ + fineStep_);
+					      << " (sharpness " << bestSharpness_
+					      << ", " << coarse_.size() << " coarse steps)";
 		}
 		break;
 
@@ -123,16 +167,16 @@ void Af::process(IPAContext &context,
 			break;
 		}
 
-		/* Refocus only on a lasting change, not on one noisy frame */
+		/* Refocus only on a lasting change, not on a few noisy frames */
 		if (sharpness < lockedSharpness_ * dropRatio_ ||
 		    green < lockedBrightness_ * 0.6 || green > lockedBrightness_ / 0.6)
 			changeCount_++;
 		else
 			changeCount_ = 0;
 
-		if (changeCount_ >= 3) {
+		if (changeCount_ >= changeFrames_) {
 			LOG(IPASoftAf, Debug) << "Scene changed, refocusing";
-			startScan(context);
+			startScan(context, frame);
 		}
 		break;
 	}
