+
+/*
+ * Drivers convert external YUV images to RGB while sampling, with the matrix
+ * and range given as hints when the EGLImage is created. Re-create the image
+ * when a texture is drawn with a different color encoding or range than the
+ * one it was imported with (normally once per buffer).
+ */
+void gles2_buffer_set_ycbcr(struct wlr_gles2_buffer *buffer,
+		enum wlr_color_encoding encoding, enum wlr_color_range range) {
+	struct wlr_gles2_renderer *renderer = buffer->renderer;
+
+	switch (encoding) {
+	case WLR_COLOR_ENCODING_BT601:
+	case WLR_COLOR_ENCODING_BT709:
+	case WLR_COLOR_ENCODING_BT2020:
+		break;
+	default:
+		// Identity (RGB) or unknown: no hints, driver default
+		encoding = WLR_COLOR_ENCODING_NONE;
+		range = WLR_COLOR_RANGE_NONE;
+		break;
+	}
+
+	if (!buffer->external_only || !buffer->tex ||
+			(buffer->color_encoding == encoding && buffer->color_range == range)) {
+		return;
+	}
+	// Don't retry a failed import on every frame
+	buffer->color_encoding = encoding;
+	buffer->color_range = range;
+
+	struct wlr_dmabuf_attributes dmabuf = {0};
+	if (!wlr_buffer_get_dmabuf(buffer->buffer, &dmabuf)) {
+		return;
+	}
+
+	bool external_only;
+	EGLImageKHR image = wlr_egl_create_image_from_dmabuf(renderer->egl,
+		&dmabuf, encoding, range, &external_only);
+	if (image == EGL_NO_IMAGE_KHR) {
+		return;
+	}
+
+	glBindTexture(GL_TEXTURE_EXTERNAL_OES, buffer->tex);
+	renderer->procs.glEGLImageTargetTexture2DOES(GL_TEXTURE_EXTERNAL_OES, image);
+	glBindTexture(GL_TEXTURE_EXTERNAL_OES, 0);
+
+	wlr_egl_destroy_image(renderer->egl, buffer->image);
+	buffer->image = image;
 }
 
 struct wlr_gles2_buffer *gles2_buffer_get_or_create(struct wlr_gles2_renderer *renderer,
@@ -144,7 +194,8 @@
 	}
 
 	buffer->image = wlr_egl_create_image_from_dmabuf(renderer->egl,
-		&dmabuf, &buffer->external_only);
+		&dmabuf, WLR_COLOR_ENCODING_NONE, WLR_COLOR_RANGE_NONE,
+		&buffer->external_only);
 	if (buffer->image == EGL_NO_IMAGE_KHR) {
 		goto error_buffer;
 	}
@@ -581,6 +632,9 @@
 		renderer->exts.OES_egl_image_external = true;
 		load_gl_proc(&renderer->procs.glEGLImageTargetTexture2DOES,
 			"glEGLImageTargetTexture2DOES");
+		// Passed to the driver as EGL_EXT_image_dma_buf_import hints
+		renderer->wlr_renderer.color_encodings = WLR_COLOR_ENCODING_BT601 |
+			WLR_COLOR_ENCODING_BT709 | WLR_COLOR_ENCODING_BT2020;
 	}
 
