+                            gst::EventView::Tag(tag_event) => {
+                                let tags = tag_event.tag();
+                                tags.get::<gst::tags::ImageOrientation>().map(|_| {
+                                    let value = format!("rotate-{}", degrees.load(Ordering::Relaxed));
