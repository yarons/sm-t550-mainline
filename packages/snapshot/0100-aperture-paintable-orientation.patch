+        /// The shell's current output rotation in degrees (0/90/180/270).
+        ///
+        /// Phone shells rotate the whole logical output, so the preview has to be
+        /// counter-rotated on top of the camera's own mounting rotation. Read from
+        /// org.gnome.Mutter.DisplayConfig (phoc/mutter); APERTURE_DISPLAY_ROTATION
+        /// overrides it.
+        fn display_rotation(&self) -> u32 {
+            if let Some(forced) = std::env::var("APERTURE_DISPLAY_ROTATION")
+                .ok()
+                .and_then(|value| value.trim().parse::<u32>().ok())
+            {
+                return forced % 360;
+            }
+            let Some(proxy) = self.display_config.get() else {
+                return 0;
+            };
+            let Ok(state) = proxy.call_sync(
+                "GetCurrentState",
+                None,
+                gio::DBusCallFlags::NONE,
+                1000,
+                gio::Cancellable::NONE,
+            ) else {
+                return 0;
+            };
+            // (u serial, a(...) monitors, a(iiduba(ssss)a{sv}) logical monitors, a{sv})
+            if state.n_children() < 3 {
+                return 0;
+            }
+            let logical = state.child_value(2);
+            let mut rotation = 0;
+            for i in 0..logical.n_children() {
+                let monitor = logical.child_value(i);
+                if monitor.n_children() < 5 {
+                    continue;
+                }
+                let transform = monitor.child_value(3).get::<u32>().unwrap_or(0);
+                let primary = monitor.child_value(4).get::<bool>().unwrap_or(false);
+                let degrees = (transform % 4) * 90;
+                if primary || i == 0 {
+                    rotation = degrees;
+                }
+                if primary {
+                    break;
+                }
+            }
+            rotation
+        }
+
+        /// Rotates the preview to match the camera's mounting and the shell rotation.
+        ///
+        /// pipewiresrc turns the libcamera rotation into an image-orientation tag,
+        /// but the GTK4 sink did not honour it here, so the paintable's orientation
+        /// property is set directly. APERTURE_ORIENTATION (degrees) forces the total.
+        pub(crate) fn apply_orientation(&self) {
+            let Some(paintable) = self
+                .sink_paintable
+                .get()
+                .map(|sink| sink.property::<gdk::Paintable>("paintable"))
+            else {
+                return;
+            };
+            let rotation = self.total_rotation();
+            self.orientation_degrees.store(rotation, Ordering::Relaxed);
+            // GstGtk4PaintableSinkOrientation: auto, rotate-0, rotate-90, rotate-180, rotate-270, ...
+            let index = match rotation {
+                90 => 2,
+                180 => 3,
+                270 => 4,
+                _ => 1,
+            };
+            let Some(pspec) = paintable.find_property("orientation") else {
+                log::warn!("gtk4paintablesink paintable has no orientation property");
+                return;
+            };
+            let Some(class) = glib::EnumClass::with_type(pspec.value_type()) else {
+                return;
+            };
+            if let Some(value) = class.value(index) {
+                paintable.set_property("orientation", value.to_value(&class));
+            }
+        }
+
+        /// Clockwise degrees the captured frame must be turned to be upright on
+        /// screen: the inverse of the libcamera mounting rotation (libcamera's
+        /// `Rotate90` is undone by turning 270 clockwise) plus the shell rotation.
+        pub(crate) fn total_rotation(&self) -> u32 {
+            let camera_rotation = self.camera.borrow().as_ref().and_then(|camera| {
+                let properties = camera.properties();
+                let value = properties.get("api.libcamera.rotation")?;
+                value
+                    .get::<String>()
+                    .ok()
+                    .and_then(|s| s.parse::<u32>().ok())
+                    .or_else(|| value.get::<i32>().ok().map(|i| i.rem_euclid(360) as u32))
+            });
+            let display = self.display_rotation();
+            // A front camera faces the other way, so the shell rotation turns its
+            // image in the opposite direction (Android's front/back formula).
+            let front = self
+                .camera
+                .borrow()
+                .as_ref()
+                .is_some_and(|camera| matches!(camera.location(), crate::CameraLocation::Front));
+            let display_term = if front { (360 - display) % 360 } else { display };
+            let camera_term = (360 - camera_rotation.unwrap_or(0) % 360) % 360;
+            let rotation = std::env::var("APERTURE_ORIENTATION")
+                .ok()
+                .and_then(|value| value.trim().parse::<u32>().ok())
+                .unwrap_or(camera_term + display_term)
+                % 360;
+            log::info!(
+                "Orientation: libcamera rotation {camera_rotation:?} (front {front}) -> {camera_term}, display {display} -> rotate-{rotation}"
+            );
+            rotation
+        }
