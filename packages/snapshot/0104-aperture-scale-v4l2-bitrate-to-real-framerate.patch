+    /// The frame rate the camera delivers, measured over its last frames.
+    fn measured_fps(&self) -> Option<f64> {
+        let times = self.imp().frame_times.lock().unwrap();
+        if times.len() < 10 {
+            return None;
+        }
+        let span = times.back()?.checked_sub(*times.front()?)?;
+        (span > 0).then(|| (times.len() - 1) as f64 * 1e9 / span as f64)
     }
 
+    /// The frame rate in the camera's negotiated caps.
+    fn declared_fps(&self) -> Option<f64> {
+        let caps = self.imp().camera_pad.borrow().as_ref()?.current_caps()?;
+        let fps = caps.structure(0)?.get::<gst::Fraction>("framerate").ok()?;
+        (fps.numer() > 0 && fps.denom() > 0).then(|| fps.numer() as f64 / fps.denom() as f64)
+    }
+
+    /// The camera source fixates its frame rate (30 fps here), and V4L2 encoders budget every
+    /// frame for that rate. A camera behind a software ISP delivers fewer frames (24 on the
+    /// SM-T550, 8.5 on battery), so the recording got only part of DEFAULT_BITRATE. Raise the
+    /// bitrate of a V4L2 encoder by declared/measured frame rate before each recording.
+    fn scale_v4l2_bitrate(&self) {
+        let scale = match (self.declared_fps(), self.measured_fps()) {
+            (Some(declared), Some(measured)) if measured > 0.0 => (declared / measured).clamp(1.0, 4.0),
+            _ => 1.0,
+        };
+        let bitrate = (f64::from(DEFAULT_BITRATE) * 1024.0 * scale) as i32;
+        let Some(bin) = self.imp().camerabin().downcast_ref::<gst::Bin>() else {
+            return;
+        };
+        for element in bin.iterate_recurse().into_iter().flatten() {
+            if element.factory().is_some_and(|factory| factory.name() == "v4l2h264enc") {
+                log::info!("Recording with {} bit/s (frame rate scale {:.2})", bitrate, scale);
+                element.set_property(
+                    "extra-controls",
+                    gst::Structure::builder("controls")
+                        .field("video_bitrate", bitrate)
+                        .build(),
+                );
+            }
+        }
+    }
