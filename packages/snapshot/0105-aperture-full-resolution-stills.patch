+    /// The largest size (by area) among the fixed sizes in `caps`: the camera's
+    /// full resolution, which stills are taken at.
+    pub(crate) fn largest_size(caps: &gst::Caps) -> Option<Size> {
+        caps.iter()
+            .filter_map(|s| {
+                Some(Size {
+                    width: s.get::<i32>("width").ok()?,
+                    height: s.get::<i32>("height").ok()?,
+                })
+            })
+            .max_by_key(|size| size.width as i64 * size.height as i64)
+    }
