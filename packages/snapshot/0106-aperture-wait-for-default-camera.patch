+    /// Starts the default camera, or the first one, after a short grace period unless a camera was
+    /// started meanwhile.
+    fn pick_default_camera_soon(&self) {
+        if self.imp().default_pick_pending.replace(true) {
+            return;
+        }
+        glib::timeout_add_local_once(
+            std::time::Duration::from_millis(DEFAULT_CAMERA_GRACE_MS),
+            glib::clone!(
+                #[weak(rename_to = obj)]
+                self,
+                move || {
+                    let imp = obj.imp();
+                    imp.default_pick_pending.set(false);
+                    let devices = imp.devices.get().unwrap();
+                    if let Some(camera) = devices.default_camera().or_else(|| devices.camera(0))
+                        && matches!(
+                            obj.state(),
+                            ViewfinderState::NoCameras | ViewfinderState::Loading
+                        )
+                    {
+                        imp.set_state(ViewfinderState::Ready);
+                        obj.set_camera(Some(camera));
+                    }
+                }
+            ),
+        );
+    }
